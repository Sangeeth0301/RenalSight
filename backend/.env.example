# Copy to .env and fill in. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=sqlite:///./renalsight.db

# ---- AI Buddy providers. Leave a key blank to skip that provider; the router falls through the chain in order.
LLM_CHAIN=gemini,groq,openai,xai,ollama,rules
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Model names are overridable (check each provider's current model list):
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# XAI_MODEL=grok-3-mini
# Local model: install Ollama, run `ollama pull llama3.1`, then set OLLAMA_ENABLED=true
OLLAMA_ENABLED=false
# OLLAMA_MODEL=llama3.1
BUDDY_MESSAGES_PER_MINUTE=12
